# CHARDHO-AI :: environment
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8787

# Session lifetime in hours
CHARDHO_SESSION_TTL_HOURS=12

# Set to "false" only for local experiments; privileged roles require TOTP by default.
CHARDHO_REQUIRE_2FA=true

# Extra browser origins allowed to make cookie-authenticated mutations (comma separated)
CHARDHO_ALLOWED_ORIGINS=

# Show password-reset / verification links in API responses (development only)
CHARDHO_EXPOSE_SETUP_TOKENS=true

# Where the SQLite file and backups live
CHARDHO_DATA_DIR=./data

# AI provider keys — read from the environment only, never stored in the database
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Allow the hosted preview panel to embed the app (dev only).
# Leave unset in production, or list explicit trusted origins.
CHARDHO_FRAME_ANCESTORS=

# Cookie SameSite policy for the session cookie: Lax (default), Strict, or None.
# "None" is only for hosted previews embedded in a cross-site iframe.
CHARDHO_COOKIE_SAMESITE=Lax
